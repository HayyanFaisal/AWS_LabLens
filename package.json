{
  "name": "lab-report-digitizer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "sandbox": "ampx sandbox",
    "test:parser": "tsx amplify/functions/api/parser.test.ts",
    "test:api": "tsx amplify/functions/api/api.test.ts",
    "test:profile": "tsx amplify/functions/api/profile.test.ts",
    "test": "npm run test:parser --silent && npm run test:api --silent && npm run test:profile --silent",
    "typecheck": "tsc --noEmit -p amplify/tsconfig.json && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
