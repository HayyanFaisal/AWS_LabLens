    "recharts": "^3.0.0"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.25.1",
    "@aws-amplify/backend-cli": "^1.10.0",
    "@aws-sdk/client-dynamodb": "^3.1167.0",
    "@aws-sdk/client-s3": "^3.1167.0",
    "@aws-sdk/client-textract": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.1167.0",
    "@aws-sdk/s3-request-presigner": "^3.1167.0",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "aws-cdk-lib": "^2.275.0",
    "constructs": "^10.8.1",
